generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Paciente {
  id               Int      @id @default(autoincrement())
  nombres          String
  tipoDocumento    String?
  numeroDocumento  String?  @unique
  telefono         String
  nombreContacto   String?
  direccion        String
  correo           String?
  createdAt        DateTime @default(now())
}

model Emergencia {
  id            Int      @id @default(autoincrement())
  paciente      String
  prioridad     String
  estado        String
  ubicacion     String
  ambulancia    String
  createdAt     DateTime @default(now())
} 

model Servicio {
  id                 Int       @id @default(autoincrement())
  paciente           String
  edad               Int?
  peso               Float?
  tipoServicio       String
  origen             String
  referencia         String?
  destinos           String    // Guardará el array de destinos en formato JSON stringificado
  esIdaYVuelta       Boolean?  @default(false)
  diagnostico        String?
  enfermedadFondo    String?
  sintomas           String?
  tratamientoActual  String?
  requiereOxigeno    String?   @default("No")
  litrosOxigeno      Float?
  prioridad          String?
  ambulancia         String?
  observaciones      String?
  contacto           String?
  telefono           String?   // Guardará los teléfonos como string (o concatenados si hay varios)
  email              String?
  costo              Float?
  metodoPago         String?
  estado             String?
  fechaHora          DateTime?
  comprobanteTipo    String?
  comprobanteNumero  String?
  direccionEvento    String?
  horaSalidaBase     DateTime?
  horaLlegadaRecojo  DateTime?
  horaInicioTraslado DateTime?
  horaLlegadaDestino DateTime?
  horaTermino        DateTime?
  horaSalidaBase2     DateTime?
  horaLlegadaRecojo2  DateTime?
  horaInicioTraslado2 DateTime?
  horaLlegadaDestino2 DateTime?
  horaTermino2        DateTime?
  minutosEspera      Int?      @default(0)
  costoEspera        Float?    @default(0)
  descuento          Float?    @default(0)
  costoOxigeno       Float?    @default(0)
  costoDestinoAdicional Float? @default(0)
  alquilerCamilla    Boolean   @default(false)
  camillaHoras       Int?
  costoCamilla       Float?    @default(0)
  notas              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
}

model Ambulancia {
  id        Int      @id @default(autoincrement())
  placa     String   @unique
  modelo    String
  tipo      String   // E.g., Tipo I, Tipo II, Tipo III, SAMU
  estado    String   // E.g., Disponible, En Servicio, Mantenimiento
  createdAt DateTime @default(now())
}

model TripulacionDiaria {
  id              Int      @id @default(autoincrement())
  fecha           DateTime
  nombre          String
  ambulancia      String
  piloto          String
  licenciado      String?
  medico          String?
  personalAdicional String?
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fecha, nombre])
}


model PersonalQhaliKay {
  id                  Int      @id @default(autoincrement())
  nombres             String
  cargo               String?
  tipoDocumento       String?
  documento           String?
  celular             String
  cuentaBancaria      String?
  cci                 String?
  banco               String?
  yape                String?
  fechaNacimiento     DateTime?
  contactoEmergencia  String?
  direccion           String?
  cvArchivo           String?
  certificadosArchivo String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
